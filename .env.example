# Optional canonical URL used by authentication redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional together: enable authentication and public catalog/snapshot reads.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-only secret: enables catalog persistence and notifications.
SUPABASE_SERVICE_ROLE_KEY=

# Optional server-only secret used to authenticate scheduled notification processing.
CRON_SECRET=

# Optional notification observation batch size. Valid range: 1-200.
NOTIFICATION_BATCH_SIZE=50

# Optional detail metadata freshness window in hours. Default: 168 (7 days).
ANIME_DETAIL_TTL_HOURS=168
