{
  "name": "anime_watchlist",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:status": "supabase migration list --local",
    "db:status:remote": "supabase migration list --linked",
    "db:adopt:remote": "supabase migration repair 20260719000100 20260719000200 20260719000300 20260719000400 20260719000500 20260719000600 20260719000700 20260719000800 20260719000900 20260719001000 --status applied --linked",
    "db:new": "supabase migration new",
    "db:test": "supabase test db --local",
    "test:integration": "npm run db:reset && npm run db:test",
    "seed:dataset": "node --env-file=.env.local scripts/seed-offline-dataset.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "AniList-powered anime discovery website",
  "dependencies": {
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.100.0",
    "next": "^16.2.10",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "supabase": "^2.109.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
